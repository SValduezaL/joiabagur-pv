# Catálogo real de tienda: SKU, nombres y PRECIOS reales de un negocio real.
# Este repositorio es PÚBLICO. El export crudo no se versiona nunca; lo que
# C06 publique será el derivado anonimizado (data_origin: real).
data/catalog/real/*
!data/catalog/real/.gitkeep
# C06a: derivado anonimizado (JSONL + sidecar). El xlsx y el backup SQL
# siguen ocultos por el patrón de arriba.
!data/catalog/real/generated/
!data/catalog/real/generated/**

# C06b: corpus sintético versionado (JSONL + sidecar). Nada más bajo synthetic/.
data/catalog/synthetic/*
!data/catalog/synthetic/.gitkeep
!data/catalog/synthetic/generated/
!data/catalog/synthetic/generated/**

# C10: YAML de perfiles commiteado; JSONL de ventas y dumps locales no.
data/world/generated/*
!data/world/generated/.gitkeep
data/world/backups/*
!data/world/backups/.gitkeep

# Test run artifacts (dotnet test --logger trx)
TestResults/

# Claude Code: permisos locales de cada máquina
.claude/settings.local.json
